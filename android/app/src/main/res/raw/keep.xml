<?xml version="1.0" encoding="utf-8"?>
<!-- Resources looked up by name at runtime, which the release resource shrinker
     can't see. audio_service finds its rewind / play / pause / fast-forward / stop
     icons by name; on Android 13+ a missing one makes every playback update throw,
     so the media notification, lock-screen controls and foreground service never
     start (and Android mutes playback once the app is in the background). -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/audio_service_*,@drawable/ic_launcher_monochrome" />
