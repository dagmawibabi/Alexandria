<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:visibility="gone"
        android:contentDescription="Your reading and listening stats" />

    <!-- Until the app has painted this widget for the first time. -->
    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F017171A"
        android:gravity="center"
        android:padding="12dp"
        android:text="Open Alexandria to load your stats"
        android:textColor="#F4F4F5"
        android:textSize="13sp" />
</FrameLayout>
